{
  "name": "regardin-construction",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build.mjs",
    "build:production": "SITE_MODE=production npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "test:unit": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "format": "prettier --write src scripts tests functions workers *.js *.json *.md docs",
    "lint": "eslint src scripts tests functions workers *.js && stylelint 'src/**/*.css' && prettier --check src scripts tests functions workers *.js *.json *.md docs",
    "audit:html": "html-validate 'dist/**/*.html'",
    "audit:lighthouse": "lhci autorun",
    "pages:dev": "wrangler pages dev dist --port 8788 --binding SITE_MODE=preview",
    "images": "node scripts/images.mjs",
    "prebuild": "node scripts/fonts.mjs && npm run images",
    "contact-sheet": "node scripts/contact-sheet.mjs",
    "predev": "node scripts/fonts.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@fontsource/bodoni-moda": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "html-validate": "11.16.1",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "vite": "8.3.1",
    "wrangler": "4.145.0"
  }
}
