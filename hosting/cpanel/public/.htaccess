Options -Indexes
DirectoryIndex index.php index.html
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/enquiries/?$ api/enquiries/index.php [END]
  RewriteRule ^api/attachments/links/?$ api/attachments/links.php [END]
  RewriteRule ^api/attachments/([a-fA-F0-9-]{36})/?$ api/attachments/index.php?id=$1 [END,QSA]
  RewriteRule ^about-us/?$ /about/ [R=301,END]
  RewriteRule ^our-services/?$ /services/ [R=301,END]
  RewriteRule ^contact-us/?$ /contact/ [R=301,END]
  RewriteRule ^our-portfolio/?$ /projects/ [R=301,END]
  RewriteRule ^our-team/?$ /about/ [R=301,END]
  RewriteRule ^(portfolios|portfolios_category|category|tag|author|tf_header_footer|feed|comments/feed|blog)(/|$) - [G,END]
  RewriteRule ^(6-tips-to-retain-your-top-sales-talent|what-the-martian-can-teach-sales|why-your-sales-forecast-is-off|why-do-i-need-to-use-financial)(/|$) - [G,END]
</IfModule>
